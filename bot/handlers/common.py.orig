    }


def _safe_photo_index(cards: list[dict], index: int, photo_index: int) -> int:
    card = _current_feed_card(cards, index)
    if not card:
        return 0
    photos_count = max(1, len(_feed_card_photos(card)))
    return photo_index % photos_count



    "pending": ("на провер", "ожида", "pending"),
    "approved": ("опублик", "одобрен", "approved"),
    "rejected": ("отклон", "rejected"),
    "deactivated": ("скрыт", "деактив", "deactivated"),
    "all": ("все", "all"),
}



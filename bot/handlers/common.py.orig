    "deductions": ("списан", "списания", "потрат", "deduct"),
    "referrals_l1": ("1 линия", "первая линия", "l1"),
    "referrals_l2": ("2 линия", "вторая линия", "l2"),
    "partner_commissions": ("начислен", "комисс", "commission"),
    "withdrawals": ("вывод", "withdraw"),
}


# HappyFox production identity
PRODUCT_ID=happyfox
BOT_TOKEN=
ADMIN_IDS=
SUPPORT_CONTACT=

# Public HappyFox endpoints — never reuse NEUROMIX/Tanya domains
WEBHOOK_HOST=https://api.happyfox.example
WEBHOOK_PATH=/webhook
WEBHOOK_BIND_HOST=127.0.0.1
WEBHOOK_PORT=1888
MINI_APP_URL=https://app.happyfox.example/mini-app/
STATIC_BASE_URL=https://media.happyfox.example
# Production must copy provider results into static/uploads before history relies on them.
PERSIST_PROVIDER_RESULTS=1

# Dedicated data plane
DATABASE_URL=postgresql://happyfox:change-me@127.0.0.1:5432/happyfox
REDIS_URL=redis://127.0.0.1:6379/3
REDIS_PREFIX=foxgen_happyfox

# KIE/provider security
KIE_AI_API_KEY=
KIE_AI_WEBHOOK_PATH=/webhook/kie_ai
KIE_AI_WEBHOOK_SECRET=
INTERNAL_API_SECRET=
HEALTH_CHECK_SECRET=

# Instagram Creator/Business channel — disabled until Meta credentials/app review are ready.
# Uses Instagram API with Instagram Login; do not reuse Telegram or Facebook Page identities.
INSTAGRAM_ENABLED=0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_API_VERSION=v24.0
INSTAGRAM_WEBHOOK_PATH=/instagram/webhook
INSTAGRAM_REQUEST_TIMEOUT_SECONDS=30
INSTAGRAM_IDEMPOTENCY_TTL_SECONDS=604800
INSTAGRAM_SUBSCRIBED_FIELDS=messages,messaging_postbacks,comments

# MAX channel — fail-closed and isolated from Telegram balances/history/referrals.
# Production MAX uses Webhook only. When enabled, MAX_BOT_NAME is required so
# referral/payment deep links cannot silently degrade.
MAX_ENABLED=0
MAX_ACCESS_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=https://api.happyfox.example/max/webhook
MAX_WEBHOOK_PATH=/max/webhook
MAX_API_BASE=https://platform-api2.max.ru
MAX_BOT_NAME=your_bot
MAX_MINI_APP_URL=https://app.happyfox.example/mini-app/
MAX_PAYMENT_RETURN_URL=https://max.ru/your_bot?start=max_payment
MAX_PAYMENT_RECONCILE_SECONDS=30

# Billing — choose exactly one primary Telegram runtime provider.
# MAX has a separate order/ledger layer but reuses the configured YooKassa merchant credentials.
# Keep Telegram Stars available as a safe fallback if desired.
PAYMENT_PROVIDER=yookassa
TELEGRAM_STARS_ENABLED=1
TELEGRAM_STARS_PER_RUB=1
TELEGRAM_STARS_FLAT_FEE=0

# YooKassa — configure payment.succeeded and payment.canceled notifications
# in the YooKassa cabinet to WEBHOOK_HOST + YOOKASSA_WEBHOOK_PATH.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://app.happyfox.example/mini-app/
YOOKASSA_WEBHOOK_PATH=/yookassa/webhook
YOOKASSA_REQUEST_TIMEOUT_SECONDS=30
YOOKASSA_PENDING_TTL_HOURS=168

# LAVA alternative. HappyFox never reads imported Tanya offer IDs.
LAVA_API_KEY=
LAVA_WEBHOOK_SECRET=
LAVA_OFFER_ID_MINI=
LAVA_OFFER_ID_START=
LAVA_OFFER_ID_OPTIMAL=
LAVA_OFFER_ID_PRO=
LAVA_OFFER_ID_STUDIO=
LAVA_OFFER_ID_BUSINESS=
LAVA_CURRENCY=RUB

# T-Bank alternative
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=

# CryptoBot alternative
CRYPTOBOT_API_TOKEN=

# FreeKassa alternative
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_WORD=
FREEKASSA_SECRET_WORD_2=
FREEKASSA_API_KEY=

# Optional product controls
ALLOW_NSFW=0
PARTNER_MIN_WITHDRAWAL_RUB=1000

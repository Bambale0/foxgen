## NOTE: If your site is behind Cloudflare, add the Cloudflare IPs
## to nginx so the real client IP is preserved. Create
## /etc/nginx/cloudflare.conf and include it in the
## main nginx.conf inside the `http { ... }` block, for example:
##
##     include /etc/nginx/cloudflare.conf;
##
## The recommended content of /etc/nginx/cloudflare.conf is generated
## automatically by the helper script scripts/update_cloudflare_conf.sh
## (run with sudo). It will add `set_real_ip_from` entries for all
## Cloudflare IPv4/IPv6 ranges and enable `real_ip_header CF-Connecting-IP`.
##
## SSL MODE FOR CLOUDFLARE:
##   Use "Full (strict)" SSL mode in Cloudflare dashboard, NOT "Flexible".
##   Flexible SSL encrypts only browser↔Cloudflare, leaving Cloudflare↔origin
##   unencrypted, which breaks HSTS and causes VPN-related issues.
##   Generate origin certificate in Cloudflare and configure it below if you
##   can't use Let's Encrypt directly.

server {
    listen 80;
    server_name your-domain.com;

    # Redirect all traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # HSTS — critical for VPN compatibility. Some VPNs strip or modify headers,
    # making HSTS a strong signal that HTTPS is mandatory.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "ALLOW-FROM https://web.telegram.org" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # CSP: frame-ancestors is the MODERN replacement for X-Frame-Options.
    # Telegram Mini Apps must be allowed in iframe for:
    #   - Telegram Web (web.telegram.org)
    #   - Telegram native apps via tg:// protocol
    #   - The origin domain itself (for service-worker, etc.)
    # Some VPNs/proxies block iframes that lack explicit frame-ancestors.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://web.telegram.org https://*.telegram.org tg:; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org tg:; child-src 'self' https://web.telegram.org blob:; worker-src 'self' blob:; font-src 'self' data:" always;

    client_max_body_size 50m;

    location /health {
        proxy_pass http://127.0.0.1:1888/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Drop common scanner probes before they reach the bot.
    location ~* ^/(?:\.env(?:\..*)?|\.git|\.svn|\.hg|\.DS_Store|composer\.(?:json|lock)|package(?:-lock)?\.json|pnpm-lock\.yaml|yarn\.lock|Dockerfile|docker-compose\.ya?ml|phpinfo\.php|server-status|metrics|openapi\.json|docs|swagger|\.well-known/(?:ai-plugin|agent|mcp)\.json)(?:/|$) {
        access_log off;
        return 404;
    }

    location /telegram/webhook {
        proxy_pass http://127.0.0.1:1888/telegram/webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /tbank/webhook {
        proxy_pass http://127.0.0.1:1888/tbank/webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /freekassa/webhook {
        # FreeKassa Result URL: POST form-data, plain-text YES on success.
        proxy_pass http://127.0.0.1:1888/freekassa/webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 90s;
        proxy_buffering off;
        client_max_body_size 1m;
        client_body_buffer_size 128k;

        limit_except POST {
            deny all;
        }
    }

    location /webhook/ {
        proxy_pass http://127.0.0.1:1888;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:1888/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Mini App static & API — served by the Python aiohttp backend.
    # CORS headers are added here so API requests (fetch/XHR) from the Mini App
    # iframe pass through VPNs and proxies that enforce CORS preflight checks.
    #
    # IMPORTANT: nginx replaces server-level add_header when location-level
    # add_header is present. We repeat the security headers here explicitly.
    location /mini-app/ {
        proxy_pass http://127.0.0.1:1888;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Security (repeated from server block — nginx location overrides)
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "ALLOW-FROM https://web.telegram.org" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://web.telegram.org https://*.telegram.org tg:; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org tg:; child-src 'self' https://web.telegram.org blob:; worker-src 'self' blob:; font-src 'self' data:" always;

        # CORS for Mini App API
        add_header Access-Control-Allow-Origin "$http_origin" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Telegram-Init-Data, X-Requested-With" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Max-Age "86400" always;

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    # API v1 endpoints — same CORS treatment
    location /api/ {
        proxy_pass http://127.0.0.1:1888;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Security (repeated from server block — nginx location overrides)
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "ALLOW-FROM https://web.telegram.org" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://web.telegram.org https://*.telegram.org tg:; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org tg:; child-src 'self' https://web.telegram.org blob:; worker-src 'self' blob:; font-src 'self' data:" always;

        add_header Access-Control-Allow-Origin "$http_origin" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Telegram-Init-Data, X-Requested-With" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Max-Age "86400" always;

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    location / {
        proxy_pass http://127.0.0.1:1888;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# Dedicated HappyFox AI support bot.
# Copy to .env.happyfox.support on the production host and fill secrets there.
# Never commit the real token or Kie key.

SUPPORT_BOT_TOKEN=

# Optional dedicated Kie key. If empty, runtime falls back to KIE_AI_API_KEY
# from the existing HappyFox runtime.
SUPPORT_KIE_API_KEY=

SUPPORT_AI_MODEL=gpt-5-5
SUPPORT_AI_REASONING_EFFORT=medium
SUPPORT_AI_TIMEOUT_SECONDS=90
SUPPORT_AI_MAX_ATTEMPTS=3
SUPPORT_HISTORY_TTL_SECONDS=86400
SUPPORT_HISTORY_MAX_MESSAGES=12

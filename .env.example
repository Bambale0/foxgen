FOXGEN_ENV=local
FOXGEN_LOG_LEVEL=INFO
FOXGEN_API_HOST=0.0.0.0
FOXGEN_API_PORT=8080

FOXGEN_TELEGRAM_BOT_TOKEN=
FOXGEN_TELEGRAM_FSM_TTL_SECONDS=3600
FOXGEN_TELEGRAM_INPUT_MAX_BYTES=52428800
FOXGEN_TELEGRAM_INPUT_STORAGE_ROOT=/var/lib/foxgen/input-media
FOXGEN_TELEGRAM_INPUT_PRESIGNED_URL_TTL_SECONDS=21600
FOXGEN_TELEGRAM_INPUT_RETENTION_SECONDS=172800

# Happy Fox public Telegram Mini App. Static UI is served at /mini-app/.
# JWT secret must be a dedicated random production secret and is never exposed to the browser.
FOXGEN_MINIAPP_ENABLED=true
FOXGEN_MINIAPP_JWT_SECRET=
FOXGEN_MINIAPP_AUTH_MAX_AGE_SECONDS=86400
FOXGEN_MINIAPP_JWT_TTL_SECONDS=3600
FOXGEN_MINIAPP_MEDIA_URL_TTL_SECONDS=300

FOXGEN_DATABASE_URL=postgresql+asyncpg://foxgen:foxgen@postgres:5432/foxgen
FOXGEN_REDIS_URL=redis://redis:6379/0
FOXGEN_INTERNAL_API_BASE_URL=http://api:8080
FOXGEN_INTERNAL_API_TIMEOUT_SECONDS=30

FOXGEN_KIE_API_KEY=
FOXGEN_KIE_BASE_URL=https://api.kie.ai
FOXGEN_KIE_CALLBACK_BASE_URL=
FOXGEN_KIE_WEBHOOK_HMAC_KEY=
FOXGEN_WEBHOOK_MAX_AGE_SECONDS=300

# Paid provider submission is fail-closed. Keep disabled until auth, pricing, wallet,
# provider credentials and lifecycle configuration are intentionally ready.
FOXGEN_TASK_SUBMISSION_ENABLED=false
FOXGEN_INTERNAL_API_TOKEN=
FOXGEN_SUBMISSION_USER_RATE_LIMIT_PER_MINUTE=10
FOXGEN_SUBMISSION_GLOBAL_RATE_LIMIT_PER_MINUTE=100
FOXGEN_SUBMISSION_USER_CONCURRENCY_LIMIT=2
FOXGEN_SUBMISSION_GLOBAL_CONCURRENCY_LIMIT=20

# Legacy billing-admin mutations remain separately protected.
FOXGEN_BILLING_ADMIN_API_ENABLED=false
FOXGEN_BILLING_ADMIN_API_TOKEN=

# Full admin control plane. The signed API/internal operator surface are disabled by default.
# These are backend credentials and must never be embedded into a public frontend/Mini App.
FOXGEN_ADMIN_API_ENABLED=false
FOXGEN_ADMIN_WEB_ENABLED=false
FOXGEN_ADMIN_HMAC_KEY=
FOXGEN_ADMIN_HMAC_MAX_SKEW_SECONDS=300
# Local Compose may call API from another private container address. Production should narrow this.
FOXGEN_ADMIN_NETWORK_ALLOWLIST=127.0.0.1/32,::1/128,172.16.0.0/12
# Comma-separated Telegram IDs that bootstrap as superadmin. Prefer DB-managed RBAC after bootstrap.
FOXGEN_ADMIN_SUPERUSER_IDS=
FOXGEN_ADMIN_SESSION_TTL_SECONDS=900
FOXGEN_ADMIN_WORKER_BATCH_SIZE=50
FOXGEN_ADMIN_WORKER_LEASE_SECONDS=120
FOXGEN_ADMIN_WORKER_MAX_ATTEMPTS=8
FOXGEN_ADMIN_NOTIFICATION_RATE_PER_SECOND=20

FOXGEN_WORKER_LOOP_INTERVAL_SECONDS=1
FOXGEN_WORKER_OUTBOX_BATCH_SIZE=10
FOXGEN_WORKER_OUTBOX_LEASE_SECONDS=120
FOXGEN_WORKER_OUTBOX_MAX_ATTEMPTS=8
FOXGEN_PROVIDER_POLL_INTERVAL_SECONDS=20
FOXGEN_STALE_SUBMITTING_SECONDS=600

FOXGEN_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=60
FOXGEN_MEDIA_MAX_BYTES=536870912
FOXGEN_MEDIA_PRESIGNED_URL_TTL_SECONDS=3600

# Local Docker Compose MinIO only. Never use these development credentials in production.
# Application media code never creates buckets during request/worker execution.
# Repository Compose provisions its bundled MinIO bucket through minio-init; external
# S3-compatible deployments must provision a private bucket explicitly before startup.
FOXGEN_S3_ENDPOINT_URL=http://minio:9000
FOXGEN_S3_REGION=us-east-1
FOXGEN_S3_BUCKET=foxgen-media
FOXGEN_S3_ACCESS_KEY_ID=foxgen
FOXGEN_S3_SECRET_ACCESS_KEY=foxgen-development-secret
FOXGEN_S3_FORCE_PATH_STYLE=true

# Compose MinIO bootstrap owns only the temporary Telegram inputs/ lifecycle rule.
# Durable generated result objects under generations/ are never targeted by this short retention.
FOXGEN_INPUT_RETENTION_DAYS=2
FOXGEN_INPUT_MULTIPART_ABORT_DAYS=1
FOXGEN_MINIO_INIT_ATTEMPTS=30
FOXGEN_MINIO_INIT_RETRY_SECONDS=2

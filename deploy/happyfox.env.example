# HappyFox production environment template.
# Copy to server-side .env and fill secrets there. Never commit real values.

# Product identity
PRODUCT_ID=happyfox

# Telegram / public URLs
BOT_TOKEN=
WEBHOOK_HOST=https://api.happyfox.example
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=1888
WEBHOOK_BIND_HOST=127.0.0.1
MINI_APP_URL=https://app.happyfox.example/mini-app/
STATIC_BASE_URL=https://media.happyfox.example
ADMIN_IDS=

# Required isolated data stores
# Use a HappyFox-only database/user; do not point to NEUROMIX/Tanya data.
DATABASE_URL=postgresql://happyfox:CHANGE_ME@127.0.0.1:5432/happyfox
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PREFIX=foxgen_happyfox

# Primary AI provider
KIE_AI_API_KEY=
KIE_AI_WEBHOOK_PATH=/webhook/kie_ai
KIE_AI_WEBHOOK_SECRET=
KIE_WEBHOOK_HMAC_KEY=

# Optional provider fallbacks / model integrations
GEMINI_API_KEY=
KLING_API_KEY=
PIAPI_API_KEY=
NANOBANANA_API_KEY=
NANOBANANA2_FALLBACK_API_KEY=
NANOBANANA2_FALLBACK_BASE_URL=
NANO_BANANA_PRO_FALLBACK_API_KEY=
NANO_BANANA_PRO_FALLBACK_BASE_URL=

# Payments — enable only providers configured for this HappyFox bot.
PAYMENT_PROVIDER=cryptobot
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_USE_TESTNET=0
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_SUCCESS_URL=
TELEGRAM_STARS_ENABLED=1
TELEGRAM_STARS_PER_RUB=1
TELEGRAM_STARS_FLAT_FEE=0

# Optional subscription gate. Empty means disabled for HappyFox.
REQUIRED_CHANNEL_USERNAME=

# Storage / delivery (optional if local uploads are served by the product host)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Partner programme
PARTNER_OFFER_URL=
PARTNER_RULES_URL=
PARTNER_MIN_WITHDRAWAL_RUB=1000

# Runtime safeguards
ALLOW_NSFW=0
BANANO_SKIP_PROJECT_ENV=1
BANANO_LOG_TO_STDOUT=1

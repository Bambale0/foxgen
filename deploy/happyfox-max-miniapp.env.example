# HappyFox MAX Mini App standalone HTTPS origin.
# Copy this file to a root-readable runtime config after DNS exists, set
# CERTBOT_EMAIL, then run scripts/install_miniapp_frontend_https_host.sh.
#
# Canonical production deploy remains authoritative for the exact main SHA
# after this origin has been provisioned.

FRONTEND_DOMAIN=max.happy-fox.online
BACKEND_ORIGIN=https://api.happy-fox.online
CERTBOT_EMAIL=

# HappyFox source only.
REPO_URL=https://github.com/Bambale0/foxgen.git
REPO_BRANCH=main
SOURCE_DIR=/opt/happyfox-max-miniapp-src
RUN_NPM_AUDIT=1
FORCE_RESET_SOURCE=0
NODE_MAJOR=22

# Dedicated MAX webroot; never reuse Telegram's /var/www/happyfox-app root.
WEB_ROOT=/var/www/happyfox-max
MINIAPP_ROOT=/var/www/happyfox-max/mini-app
BACKUP_ROOT=/var/backups/foxgen-happyfox/max-miniapp
KEEP_BACKUPS=7

# Proxy API requests to the HappyFox application/data plane over HTTPS.
BACKEND_HOST_HEADER=api.happy-fox.online
BACKEND_TLS_NAME=api.happy-fox.online
BACKEND_HEALTH_PATH=/health
CLIENT_MAX_BODY_SIZE=60M
PROXY_TIMEOUT_SECONDS=600

ENABLE_UFW=1
SKIP_TLS=0
SKIP_DNS_CHECK=0

# Intentionally empty: provisioning the MAX frontend must not mutate Telegram
# MINI_APP_URL or restart a separate backend service.
BACKEND_SSH_HOST=

# Copy to /root/foxgen/.env on the production server and replace every placeholder.
# This file is documentation/configuration input only; deploy never uploads or overwrites .env.
# Keep chmod 600 and use independent secrets for each trust boundary.

FOXGEN_ENV=production
FOXGEN_LOG_LEVEL=INFO
FOXGEN_API_HOST=0.0.0.0
FOXGEN_API_PORT=8080
# Production Compose binds this host port to 127.0.0.1 for the reverse proxy.
FOXGEN_PUBLIC_API_PORT=8080

FOXGEN_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
FOXGEN_TELEGRAM_FSM_TTL_SECONDS=3600
FOXGEN_TELEGRAM_INPUT_MAX_BYTES=52428800
FOXGEN_TELEGRAM_INPUT_STORAGE_ROOT=/var/lib/foxgen/input-media
FOXGEN_TELEGRAM_INPUT_PRESIGNED_URL_TTL_SECONDS=21600
FOXGEN_TELEGRAM_INPUT_RETENTION_SECONDS=172800

FOXGEN_POSTGRES_DB=foxgen
FOXGEN_POSTGRES_USER=foxgen
FOXGEN_POSTGRES_PASSWORD=<long-random-postgres-password>
FOXGEN_DATABASE_URL=postgresql+asyncpg://foxgen:<url-encoded-postgres-password>@postgres:5432/foxgen

FOXGEN_REDIS_PASSWORD=<long-random-redis-password>
FOXGEN_REDIS_URL=redis://:<url-encoded-redis-password>@redis:6379/0

# Trusted bot/backend service path. Never expose this token to Telegram clients or public frontend code.
FOXGEN_INTERNAL_API_BASE_URL=http://api:8080
FOXGEN_INTERNAL_API_TIMEOUT_SECONDS=30
FOXGEN_INTERNAL_API_TOKEN=<long-random-internal-api-token>

FOXGEN_KIE_API_KEY=<kie-api-key>
FOXGEN_KIE_BASE_URL=https://api.kie.ai
FOXGEN_KIE_CALLBACK_BASE_URL=https://foxgen.example.com
FOXGEN_KIE_WEBHOOK_HMAC_KEY=<long-random-webhook-secret>
FOXGEN_WEBHOOK_MAX_AGE_SECONDS=300

# Paid generation admission remains fail-closed until explicitly enabled after pricing/balance/provider smoke checks.
FOXGEN_TASK_SUBMISSION_ENABLED=false
FOXGEN_SUBMISSION_USER_RATE_LIMIT_PER_MINUTE=10
FOXGEN_SUBMISSION_GLOBAL_RATE_LIMIT_PER_MINUTE=100
FOXGEN_SUBMISSION_USER_CONCURRENCY_LIMIT=2
FOXGEN_SUBMISSION_GLOBAL_CONCURRENCY_LIMIT=20

# Legacy /v1/admin billing/reconciliation credential. Prefer the full admin service layer for new operator features.
FOXGEN_BILLING_ADMIN_API_ENABLED=false
FOXGEN_BILLING_ADMIN_API_TOKEN=<separate-long-random-admin-token>

# Full signed internal admin control plane. Keep disabled until migration + private-ingress smoke checks pass.
FOXGEN_ADMIN_API_ENABLED=false
FOXGEN_ADMIN_WEB_ENABLED=false
FOXGEN_ADMIN_HMAC_KEY=<separate-long-random-admin-hmac-key>
FOXGEN_ADMIN_HMAC_MAX_SKEW_SECONDS=300
# Accept only real backend/loopback callers; narrow this to the actual Docker/VPC subnet when known.
FOXGEN_ADMIN_NETWORK_ALLOWLIST=127.0.0.1/32,::1/128,172.16.0.0/12
# Bootstrap only. Move long-lived operational access to durable admin_users RBAC.
FOXGEN_ADMIN_SUPERUSER_IDS=<telegram-admin-id>
FOXGEN_ADMIN_SESSION_TTL_SECONDS=900
FOXGEN_ADMIN_WORKER_BATCH_SIZE=50
FOXGEN_ADMIN_WORKER_LEASE_SECONDS=120
FOXGEN_ADMIN_WORKER_MAX_ATTEMPTS=8
FOXGEN_ADMIN_NOTIFICATION_RATE_PER_SECOND=20

FOXGEN_WORKER_LOOP_INTERVAL_SECONDS=1
FOXGEN_WORKER_OUTBOX_BATCH_SIZE=10
FOXGEN_WORKER_OUTBOX_LEASE_SECONDS=120
FOXGEN_WORKER_OUTBOX_MAX_ATTEMPTS=8
FOXGEN_PROVIDER_POLL_INTERVAL_SECONDS=20
FOXGEN_STALE_SUBMITTING_SECONDS=600

FOXGEN_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=60
FOXGEN_MEDIA_MAX_BYTES=536870912
FOXGEN_MEDIA_PRESIGNED_URL_TTL_SECONDS=3600

# Private MinIO inside docker-compose.prod.yml. PostgreSQL/Redis/MinIO are not host-public in production.
# Application request/worker code never creates buckets. Repository Compose provisions the bundled
# MinIO bucket through minio-init. If this topology is replaced with external S3-compatible storage,
# provision a private bucket explicitly before starting FoxGen and verify equivalent inputs/ lifecycle.
FOXGEN_S3_ENDPOINT_URL=http://minio:9000
FOXGEN_S3_REGION=us-east-1
FOXGEN_S3_BUCKET=foxgen-media
FOXGEN_S3_ACCESS_KEY_ID=<random-minio-access-key>
FOXGEN_S3_SECRET_ACCESS_KEY=<long-random-minio-secret>
FOXGEN_S3_FORCE_PATH_STYLE=true

# Production Compose installs and verifies this rule before API/worker/bot startup.
# Applies only to temporary Telegram input objects under inputs/; never to durable generations/.
FOXGEN_INPUT_RETENTION_DAYS=2
FOXGEN_INPUT_MULTIPART_ABORT_DAYS=1
FOXGEN_MINIO_INIT_ATTEMPTS=30
FOXGEN_MINIO_INIT_RETRY_SECONDS=2

# Reverse proxy MUST deny /internal/admin/ on public ingress. Backend admin callers use the private network.
